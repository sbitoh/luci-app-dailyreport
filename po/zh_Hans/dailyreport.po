msgid "Test Execution Result"
msgstr "推送测试结果"

msgid "Execution Output Log:"
msgstr "执行输出日志："

msgid "(Finished)"
msgstr "(执行完毕)"

msgid "OK"
msgstr "确定"

msgid "Execution failed: %s"
msgstr "执行失败: %s"

msgid "Feature Modules Switch"
msgstr "功能模块开关"

