msgid "System & Traffic Daily Report"
msgstr "系统与流量日报"

msgid "Automatically collects system health, WAN traffic, top sites, and security audit, delivering scheduled reports."
msgstr "每日定时汇总系统状态、全网外网流量、网站访问与安全审计，并自动推送报告。"

msgid "General Settings"
msgstr "基本设置"

msgid "Enable Daily Report Service"
msgstr "启用日报服务"

msgid "Daily Delivery Hour (O'clock)"
msgstr "每日推送时间 (整点)"

msgid "CPU High Temp Alert Threshold (°C)"
msgstr "CPU 高温告警阈值 (°C)"

msgid "Enable Emergency Overheat Shutdown"
msgstr "启用高温紧急关机保护"

msgid "Sends urgent critical Gotify/Email alert and safely powers off after 3 minutes if CPU exceeds threshold."
msgstr "当 CPU 温度达到告警阈值时，向 Gotify 发送最高优先级紧急告警，并在 3 分钟后安全关机以保护硬件。"

msgid "Send Test Report"
msgstr "立即推送测试"

msgid "Generate & Send Report Now"
msgstr "立即生成并发送日报"

msgid "Generating and Sending Report…"
msgstr "正在生成并发送日报…"

msgid "Collecting system status and traffic data, sending to configured channels, please wait…"
