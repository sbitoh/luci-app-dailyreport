{
	"luci-app-dailyreport": {
		"description": "Grant UCI and execute access for luci-app-dailyreport",
		"read": {
			"cgi-io": [ "exec" ],
			"file": {
				"/usr/share/dailyreport/dailyreport_core.sh test": [ "exec" ]
			},
			"ubus": {
				"luci": [ "setInitAction" ]
			},
			"uci": [ "dailyreport" ]
		},
		"write": {
			"file": {
				"/usr/share/dailyreport/dailyreport_core.sh test": [ "exec" ]
			},
			"uci": [ "dailyreport" ]
		}
	}
}
